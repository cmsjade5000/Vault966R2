DATABASE_URL=postgresql+psycopg://vault_user:vault_pass@localhost:5432/vault966
# For SQLite (default), leave unset or set to:
# DATABASE_URL=sqlite:///./vault.db

# External enrichment (optional)
TMDB_API_KEY=
OMDB_API_KEY=

# OpenAI (server-side) and semantic search (pgvector)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIM=1536
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_SEARCH_TOP_K=200
SEMANTIC_CACHE_TTL_HOURS=24
SEMANTIC_BACKFILL_BATCH=32
SEMANTIC_BACKFILL_SLEEP_SECONDS=0.4

# CORS origins for a future Next.js frontend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_NAME=vault966-r2 API
ADMIN_TOKEN=changeme
