# Deny the entire client-to-daemon build context by default. Re-include only
# the Docker metadata and runtime sources copied by Dockerfile.
**
!Dockerfile
!.dockerignore
!requirements.txt
!alembic.ini
!alembic
!alembic/**
!api
!api/**
!core
!core/**
!static
!static/**
!templates
!templates/**
!scripts
!scripts/backfill_backdrops.py
!scripts/backfill_db_backup.py
!scripts/backfill_moods.py
!scripts/backfill_posters.py
!scripts/normalize_genres.py
!scripts/sqlite_maintenance.py

# Defense in depth for generated or private artifacts inside allowed roots.
core/agents.md
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.pyd
**/.DS_Store
**/.env
**/.env.*
**/*.sqlite3
**/*.db
**/*.db-*
**/*.db.*
**/*.bak
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.7z
**/*.rar
**/*[Bb]oard*[Ss]napshot*
**/*[Bb]oard*[Aa]rtifact*
