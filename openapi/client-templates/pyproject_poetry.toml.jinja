{# Based on openapi-python-client 0.29.1; preserve the certifi security floor on regeneration. #}
[tool.poetry]
name = "{{ project_name }}"
version = "{{ package_version | in_double_quote_literal }}"
description = "{{ package_description | in_double_quote_literal }}"
authors = []
readme = "README.md"
packages = [
    { include = "{{ package_name }}" },
]
include = ["{{ package_name }}/py.typed"]

[tool.poetry.dependencies]
python = "^3.11"
httpx = ">=0.23.1,<0.29.0"
attrs = ">=22.2.0"
# GHSA-6q48-6c7w-9gw2; 2026.10.19 retains unaffected emSign roots.
certifi = ">=2026.10.19"

[build-system]
requires = ["poetry-core>=2.0.0,<3.0.0"]
build-backend = "poetry.core.masonry.api"
